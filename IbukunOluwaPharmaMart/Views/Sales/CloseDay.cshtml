@model List<IbukunOluwaPharmaMart.Models.Sale>
@{
    ViewData["Title"] = "Daily Closing";
    DateTime day = ViewBag.Day;
    string cashStr = ((decimal)ViewBag.CashCollected).ToString("N2");
    string totalSalesStr = ((decimal)ViewBag.TotalSales).ToString("N2");
    string transferStr = ((decimal)ViewBag.TransferCollected).ToString("N2");
    string posStr = ((decimal)ViewBag.PosCollected).ToString("N2");
    string collectedStr = ((decimal)ViewBag.TotalCollected).ToString("N2");
    string owingStr = ((decimal)ViewBag.TotalOwing).ToString("N2");
    string openingStr = ((decimal)ViewBag.OpeningCash).ToString("N2");
    string expensesStr = ((decimal)ViewBag.Expenses).ToString("N2");
    string remitStr = ((decimal)ViewBag.CashToRemit).ToString("N2");
    Layout = "_Layout";
}

<style>
    .closing-wrap{max-width:1080px;margin:0 auto}
    .top-bar{background:#fff;border-radius:16px;box-shadow:0 8px 25px rgba(0,0,0,.06);padding:18px 20px}
    .brand-dot{width:48px;height:48px;border-radius:14px;background:#e8f8ef;display:flex;align-items:center;justify-content:center;font-size:24px}
    .hero{background:linear-gradient(135deg,#0f9d58 0%,#0a7a44 60%,#065f33 100%);color:#fff;border-radius:20px;padding:28px 24px;position:relative;overflow:hidden;box-shadow:0 15px 35px rgba(15,157,88,.28)}
    .hero::after{content:"₦";position:absolute;right:18px;top:-22px;font-size:150px;font-weight:900;opacity:.10;transform:rotate(12deg)}
    .hero small{letter-spacing:.18em;text-transform:uppercase;opacity:.85;font-weight:700;font-size:11px}
    .hero h1{font-size:52px;font-weight:900;line-height:1;margin:8px 0 6px;letter-spacing:-1px}
    .hero p{opacity:.9;margin:0;font-size:13.5px}
    .kpi{background:#fff;border:0;border-radius:16px;box-shadow:0 8px 25px rgba(0,0,0,.06);padding:16px;height:100%}
    .kpi small{color:#6c757d;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:11px}
    .kpi h4{font-weight:900;margin:6px 0 2px;font-size:22px}
    .kpi span{font-size:12px;color:#888}
    .kpi-icon{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:2px}
    .table-card{background:#fff;border-radius:18px;box-shadow:0 8px 25px rgba(0,0,0,.06);overflow:hidden}
    .badge-pay{padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700}
    .badge-Cash{background:#e8f8ef;color:#0a7a44}
    .badge-Transfer{background:#e7f0ff;color:#0b5ed7}
    .badge-POS,.badge-Card{background:#fff3cd;color:#8a6d00}
    .sign-box{border-top:1px dashed #ddd;padding-top:16px}
    .sign-line{border-bottom:1px solid #222;height:32px;margin-top:4px}
    .calc-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px dashed #eee;font-size:15px}
    .calc-row:last-child{border-bottom:0}

    /* --- FIXED: PRINT - Hide sidebar / navbar / everything except closing sheet --- */
    @@media print{
        /* Hide your Layout sidebar, topbar, footer - works for most layouts */
        aside, nav, header, footer, .sidebar, .navbar, .topbar, .main-sidebar, .app-sidebar, .left-sidebar, .no-print { display:none !important; }
        body{ background:#fff !important; }
        .container, .container-fluid, main, .content, .content-wrapper, .main-content, .page-content { margin:0 !important; padding:0 !important; max-width:100% !important; width:100% !important; }
        .closing-wrap{ max-width:100% !important; margin:0 !important; }
        .kpi,.top-bar,.table-card,.hero{ box-shadow:none !important; border:1px solid #ddd !important; }
        .hero{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        a{ text-decoration:none !important; color:#000 !important; }
        /* Hide the input form when printing, show only result */
        .print-hide-form{ display:none !important; }
    }
</style>

<div class="closing-wrap">
    <div class="top-bar d-flex justify-content-between align-items-center mb-3 no-print">
        <div class="d-flex gap-3 align-items-center">
            <div class="brand-dot">💊</div>
            <div>
                <h4 class="fw-bold mb-0">IbukunOluwa PharmaMart</h4>
                <small class="text-muted">Daily Closing &nbsp;•&nbsp; Shift Report</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Sales/Report" class="btn btn-outline-secondary rounded-pill">← Sales Report</a>
            <button onclick="window.print()" class="btn btn-dark rounded-pill px-4">🖨️ Print Closing</button>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 px-1">
        <div>
            <h3 class="fw-bold mb-0" style="letter-spacing:-.5px">Daily Closing</h3>
            <div class="text-muted" style="font-size:14px">
                <span class="badge bg-success-subtle text-success border rounded-pill px-2 py-1">@day.ToString("dddd, dd MMM yyyy")</span>
                &nbsp; Cashier: <b class="text-dark">@ViewBag.CashierName</b> &nbsp;•&nbsp; @ViewBag.TransactionCount transaction(s)
            </div>
        </div>
    </div>

    <!-- NEW: OPENING + EXPENSES FORM - HIDDEN WHEN PRINTING -->
    <form method="get" class="card p-3 mb-3 print-hide-form no-print">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="fw-bold small">Date</label><input type="date" name="date" value="@day.ToString("yyyy-MM-dd")" class="form-control rounded-3" /></div>
            <div class="col-md-3"><label class="fw-bold small">💵 Opening Cash (Change Given)</label><input type="number" step="0.01" min="0" name="openingCash" value="@((decimal)ViewBag.OpeningCash)" class="form-control rounded-3" placeholder="e.g. 10000" /></div>
            <div class="col-md-3"><label class="fw-bold small">🧾 Expenses From Drawer</label><input type="number" step="0.01" min="0" name="expenses" value="@((decimal)ViewBag.Expenses)" class="form-control rounded-3" placeholder="e.g. 2000 pure water" /></div>
            <div class="col-md-3 d-flex gap-2"><button class="btn btn-success rounded-pill px-4 flex-fill">Calculate</button><a href="/Sales/CloseDay" class="btn btn-outline-secondary rounded-pill">Reset</a></div>
        </div>
        <small class="text-muted mt-2">Formula: <b>Cash to Remit = Cash Collected + Opening Cash - Expenses</b> &nbsp;•&nbsp; Opening = money you gave cashier in morning for change. Expenses = money cashier spent from drawer during day.</small>
    </form>

    <!-- HERO -->
    <div class="hero mb-3">
        <div class="d-flex justify-content-between align-items-start" style="position:relative;z-index:2">
            <div>
                <small>Cash to remit to owner</small>
                <h1>₦@remitStr</h1>
                <p>Count the cash in the drawer and hand over this exact amount. Transfer &amp; POS are already in the bank.</p>
                <div class="mt-3 bg-white bg-opacity-25 rounded-3 p-2 px-3" style="font-size:13px">
                    <div>Cash Collected: <b>₦@cashStr</b> &nbsp;+&nbsp; Opening: <b>₦@openingStr</b> &nbsp;-&nbsp; Expenses: <b>₦@expensesStr</b> &nbsp;=&nbsp; <b>₦@remitStr</b></div>
                </div>
            </div>
            <div class="text-end d-none d-md-block">
                <div class="bg-white text-dark rounded-4 px-3 py-2 shadow-sm" style="min-width:150px">
                    <small class="text-muted fw-bold" style="font-size:11px;letter-spacing:.12em">TOTAL COLLECTED</small>
                    <div class="fw-bold" style="font-size:20px">₦@collectedStr</div>
                    <small class="text-muted">Cash + Transfer + POS</small>
                </div>
            </div>
        </div>
    </div>

    <!-- BREAKDOWN - PRINT VISIBLE -->
    <div class="card p-3 mb-3">
        <h6 class="fw-bold mb-2">🧮 Cash Reconciliation</h6>
        <div class="calc-row"><span>Cash Sales Collected Today</span><b>₦@cashStr</b></div>
        <div class="calc-row"><span>(+) Opening Cash - Change given in morning</span><b>₦@openingStr</b></div>
        <div class="calc-row"><span>(-) Expenses Paid From Drawer</span><b class="text-danger">- ₦@expensesStr</b></div>
        <div class="calc-row" style="font-size:18px"><span class="fw-bold">= Cash To Remit</span><b class="text-success">₦@remitStr</b></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="kpi"><div class="kpi-icon" style="background:#eef2ff">🧾</div><small>Total Sales</small><h4>₦@totalSalesStr</h4><span>@ViewBag.TransactionCount receipts</span></div></div>
        <div class="col-6 col-md-3"><div class="kpi" style="border:2px solid #198754"><div class="kpi-icon" style="background:#e8f8ef">💵</div><small>Cash Collected</small><h4 class="text-success">₦@cashStr</h4><span>In drawer</span></div></div>
        <div class="col-6 col-md-3"><div class="kpi"><div class="kpi-icon" style="background:#e7f0ff">🏦</div><small>Transfer</small><h4 class="text-primary">₦@transferStr</h4><span>In bank</span></div></div>
        <div class="col-6 col-md-3"><div class="kpi"><div class="kpi-icon" style="background:#fff3cd">💳</div><small>POS / Card</small><h4>₦@posStr</h4><span>In bank</span></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-7"><div class="kpi d-flex justify-content-between align-items-center" style="height:auto"><div><small>Total Collected Today</small><h4 class="mb-0">₦@collectedStr</h4></div><div class="text-end"><small>Cash + Transfer + POS</small><div class="fw-bold text-success">✓ Reconciled</div></div></div></div>
        <div class="col-md-5"><div class="kpi d-flex justify-content-between align-items-center" style="height:auto;border:1px solid #ffe08a;background:#fffdf3"><div><small class="text-warning-emphasis">Customers Owing</small><h4 class="mb-0 text-danger">₦@owingStr</h4></div><div class="text-end"><small>Balance not yet paid</small><div class="fw-bold text-danger">Follow up</div></div></div></div>
    </div>

    <div class="table-card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0">✍️ Sign-Off &amp; Confirmation</h6>
            <span class="badge bg-light text-dark border">Must be signed before leaving</span>
        </div>
        <p class="text-muted mb-3" style="font-size:13px">I, <b>@ViewBag.CashierName</b>, confirm that I counted <b>₦@remitStr</b> cash (Cash ₦@cashStr + Opening ₦@openingStr - Expenses ₦@expensesStr) and handed it over.</p>
        <div class="row sign-box">
            <div class="col-md-4"><small class="fw-bold text-muted">CASHIER NAME &amp; SIGNATURE</small><div class="fw-bold mt-1">@ViewBag.CashierName</div><div class="sign-line"></div><small class="text-muted">Sign &amp; Date</small></div>
            <div class="col-md-4"><small class="fw-bold text-muted">MANAGER / OWNER</small><div class="fw-bold mt-1">______________________</div><div class="sign-line"></div><small class="text-muted">Sign &amp; Date</small></div>
            <div class="col-md-4"><small class="fw-bold text-muted">CASH COUNTED &amp; VERIFIED</small><div class="mt-1"><span class="badge bg-success">₦@remitStr Confirmed</span></div><div class="sign-line"></div><small class="text-muted">Amount verified by manager</small></div>
        </div>
    </div>

    <div class="table-card">
        <div class="d-flex justify-content-between align-items-center p-3 pb-0">
            <h6 class="fw-bold mb-0">All Sales — @day.ToString("dd MMM yyyy") <span class="badge bg-success-subtle text-success ms-1">@ViewBag.TransactionCount</span></h6>
            <small class="text-muted">Sorted by latest</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light"><tr><th>Receipt</th><th>Time</th><th>Customer</th><th>Payment</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Owing</th></tr></thead>
                <tbody>
                @foreach(var s in Model)
                {
                    string badgeClass = s.PaymentType == "Cash" ? "badge-Cash" : s.PaymentType == "Transfer" ? "badge-Transfer" : "badge-POS";
                    <tr>
                        <td class="fw-bold text-success">@s.ReceiptNo</td>
                        <td class="text-muted">@s.Date.ToString("hh:mm tt")</td>
                        <td class="fw-medium">@s.CustomerName</td>
                        <td><span class="badge-pay @badgeClass">@s.PaymentType</span></td>
                        <td class="text-end fw-bold">₦@s.TotalAmount.ToString("N2")</td>
                        <td class="text-end">₦@s.AmountPaid.ToString("N2")</td>
                        <td class="text-end fw-bold @(s.Balance > 0 ? "text-danger" : "text-success")">₦@s.Balance.ToString("N2")</td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr><td colspan="7" class="text-center p-5"><div style="font-size:36px">🧾</div><div class="fw-bold mt-1">No sales on this day</div><div class="text-muted small">Pick another date or check if sales were recorded.</div></td></tr>
                }
                </tbody>
                @if(Model.Any())
                {
                    <tfoot class="table-light"><tr><th colspan="4" class="text-end">TOTAL FOR DAY</th><th class="text-end">₦@totalSalesStr</th><th class="text-end">₦@collectedStr</th><th class="text-end text-danger">₦@owingStr</th></tr></tfoot>
                }
            </table>
        </div>
    </div>
    <p class="text-center text-muted small mt-3">IbukunOluwa PharmaMart • Generated on @DateTime.Now.ToString("dd MMM yyyy hh:mm tt") • Opening ₦@openingStr • Expenses ₦@expensesStr • Cash To Remit ₦@remitStr</p>
</div>