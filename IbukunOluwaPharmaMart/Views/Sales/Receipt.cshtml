@model IbukunOluwaPharmaMart.Models.Sale
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Receipt @Model.ReceiptNo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body{background:#eef2f7; font-family: 'Segoe UI', system-ui, sans-serif; padding:20px}
        .receipt-wrap{max-width:420px; margin:0 auto; background:#fff; border-radius:16px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.15)}
        .receipt-header{background:linear-gradient(135deg,#0f9d58 0%,#0b7a44 100%); color:#fff; padding:24px; text-align:center}
        .receipt-header h4{letter-spacing:.5px}
        .receipt-body{padding:22px}
        .meta-table td{font-size:13px; padding:2px 0}
        .items th{font-size:11px; text-transform:uppercase; letter-spacing:1px; color:#8a94a6; border-bottom:2px solid #f1f4f8 !important; padding-bottom:8px}
        .items td{font-size:14px; padding:10px 0; border-bottom:1px dashed #eef1f5}
        .total-box{background:#f8faf9; border:1px dashed #c8e6c9; border-radius:12px; padding:12px 16px}
        .watermark{position:absolute; opacity:.04; font-size:120px; font-weight:900; transform:rotate(-25deg); top:40%; left:-10%}
        @@media print{
          body{background:#fff; padding:0} 
          .receipt-wrap{box-shadow:none; border-radius:0; max-width:100%}
          .no-print{display:none !important}
        }
    </style>
</head>
<body>
<div class="receipt-wrap position-relative">
    <div class="watermark">IBUKUNOLUWA</div>
    <div class="receipt-header">
        <div class="bg-white text-success rounded-circle d-inline-flex justify-content-center align-items-center mb-2" style="width:48px;height:48px"><i class="bi bi-capsule-pill fs-4"></i></div>
        <h4 class="fw-bold mb-1">IbukunOluwa Pharma Mart</h4>
        <small style="opacity:.9">Your Health, Our Concern • RC: 123456</small><br/>
        <small style="opacity:.8; font-size:12px"><i class="bi bi-geo-alt"></i> Opp. General Hospital, Ilesa Road • <i class="bi bi-telephone"></i> 0803 123 4567</small>
    </div>

    <div class="receipt-body">
        <div class="d-flex justify-content-between mb-3">
            <table class="meta-table">
                <tr><td class="text-muted me-2">Receipt No:</td><td class="fw-bold text-success">@Model.ReceiptNo</td></tr>
                <tr><td class="text-muted">Date:</td><td>@Model.Date.ToString("dd MMM, yyyy")</td></tr>
                <tr><td class="text-muted">Time:</td><td>@Model.Date.ToString("hh:mm tt")</td></tr>
            </table>
            <div class="text-end">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">PAID</span><br/>
                <small class="text-muted" style="font-size:11px">Cashier: Admin</small>
            </div>
        </div>

        <table class="table items mb-3">
            <thead><tr><th style="width:50%">Item</th><th class="text-center">Qty</th><th class="text-end">Price</th><th class="text-end">Amt</th></tr></thead>
            <tbody>
            @foreach(var item in Model.Items ?? new List<IbukunOluwaPharmaMart.Models.SaleItem>())
            {
                <tr>
                    <td><div class="fw-semibold">@item.Product?.Name</div><small class="text-muted" style="font-size:11px">@item.Product?.Category</small></td>
                    <td class="text-center">@item.Qty</td>
                    <td class="text-end text-muted">₦@item.Price.ToString("N0")</td>
                    <td class="text-end fw-bold">₦@((item.Qty * item.Price).ToString("N0"))</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="total-box mb-3">
            <div class="d-flex justify-content-between small text-muted mb-1"><span>Subtotal (@(Model.Items?.Sum(i=>i.Qty) ?? 0) items)</span><span>₦@Model.TotalAmount.ToString("N2")</span></div>
            <div class="d-flex justify-content-between fw-bold fs-5"><span>GRAND TOTAL</span><span class="text-success">₦@Model.TotalAmount.ToString("N2")</span></div>
        </div>

        <div class="text-center py-2">
            <div class="d-inline-block border border-2 border-dark-subtle px-3 py-1" style="letter-spacing:3px; font-family:monospace; font-size:18px">|| @Model.ReceiptNo ||</div><br/>
            <small class="text-muted" style="font-size:11px">Scan to verify • Thank you for your patronage!</small>
        </div>

        <hr class="my-3" style="border-top:1px dashed #ccc"/>
        <div class="text-center">
            <small class="text-muted">Goods sold in good condition are not returnable.<br/>We care, God heals. Get well soon!</small>
        </div>

        <div class="no-print mt-4 d-grid gap-2">
            <button onclick="window.print()" class="btn btn-success rounded-pill fw-bold py-2"><i class="bi bi-printer"></i> Print Receipt</button>
            <div class="d-flex gap-2">
                <button onclick="window.close()" class="btn btn-light border rounded-pill w-50">Close</button>
                <a href="/Sales/Report" class="btn btn-dark rounded-pill w-50">Back to Report</a>
            </div>
        </div>
    </div>
</div>
</body>
</html>