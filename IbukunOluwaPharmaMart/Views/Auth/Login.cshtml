@{
    ViewData["Title"] = "Staff Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; }
        body {
            min-height: 100vh;
            background: radial-gradient(1200px 600px at 10% 10%, #e8f5e9 0%, transparent 60%),
                        radial-gradient(1000px 500px at 90% 90%, #e3f2fd 0%, transparent 60%),
                        #f6f8f7;
            display: flex; align-items: center; justify-content: center;
        }
        .login-wrapper {
            width: 100%; max-width: 980px;
            display: grid; grid-template-columns: 1.1fr 0.9fr;
            background: #fff; border-radius: 24px;
            overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        }
        .brand-side {
            background: linear-gradient(135deg, #0f9d58 0%, #0b8043 100%);
            color: white; padding: 48px 40px; position: relative;
        }
        .brand-side::after {
            content: ""; position: absolute; right: -30px; top: -30px;
            width: 200px; height: 200px; background: rgba(255,255,255,0.08);
            border-radius: 50%; filter: blur(2px);
        }
        .logo-badge {
            width: 56px; height: 56px; background: rgba(255,255,255,0.15);
            backdrop-filter: blur(10px); border-radius: 16px;
            display: grid; place-items: center; font-size: 28px; margin-bottom: 24px;
        }
        .form-side { padding: 48px 40px; }
        .form-control {
            height: 48px; border-radius: 12px; border: 1.5px solid #e8ecea;
            background: #f9fafb; transition: all .2s;
        }
        .form-control:focus {
            background: #fff; border-color: #0f9d58;
            box-shadow: 0 0 0 4px rgba(15,157,88,0.1);
        }
        .btn-login {
            height: 48px; border-radius: 12px; background: #0f9d58;
            font-weight: 600; letter-spacing: .3px; border: none;
            box-shadow: 0 8px 20px rgba(15,157,88,0.25);
        }
        .btn-login:hover { background: #0b8043; transform: translateY(-1px); }
        .role-chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.2);
            padding: 6px 12px; border-radius: 100px; font-size: 13px; margin-right: 8px; margin-top: 8px;
        }
        @@media(max-width: 768px){
            .login-wrapper { grid-template-columns: 1fr; max-width: 420px; margin: 16px; }
            .brand-side { padding: 32px 28px; }
            .form-side { padding: 32px 28px; }
        }
    </style>
</head>
<body>

<div class="login-wrapper">
    <!-- LEFT - BRAND -->
    <div class="brand-side">
        <div class="logo-badge"><i class="bi bi-capsule"></i></div>
        <h2 class="fw-bold lh-1">IbukunOluwa<br/>Pharma Mart</h2>
        <p class="mt-3 opacity-75" style="line-height:1.6">
            Secure access for pharmacy staff.<br/>
            Pharmacy, Supermarket & Essentials POS.
        </p>

        <div class="mt-4">
            <div class="role-chip"><i class="bi bi-shield-check"></i> Admin: Full Access</div>
            <div class="role-chip"><i class="bi bi-person-gear"></i> Manager: Edit Prices</div>
            <div class="role-chip"><i class="bi bi-cart3"></i> Cashier: Sell Only</div>
        </div>

        <div class="position-absolute bottom-0 start-0 p-4 opacity-50 small">
            <i class="bi bi-geo-alt"></i> Lagos, Nigeria • v2.0 POS
        </div>
    </div>

    <!-- RIGHT - FORM -->
    <div class="form-side">
        <div class="mb-4">
            <h4 class="fw-bold mb-1">Welcome back</h4>
            <p class="text-muted small">Please enter your staff credentials to continue</p>
        </div>

        @if(ViewBag.Error != null){
            <div class="alert alert-danger d-flex align-items-center rounded-3 py-2 small">
                <i class="bi bi-exclamation-circle me-2 fs-5"></i> @ViewBag.Error
            </div>
        }

        <form method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted">USERNAME</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-person text-muted"></i></span>
                    <input name="username" class="form-control border-start-0 rounded-end-3" placeholder="e.g. Admin" required autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-muted">PASSWORD</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-lock text-muted"></i></span>
                    <input name="password" type="password" class="form-control border-start-0 rounded-end-3" placeholder="••••••••" required />
                </div>
            </div>

            <button class="btn btn-login btn-success w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to POS
            </button>
        </form>

        <div class="mt-4 p-3 rounded-3" style="background:#f3f7f4; border:1px dashed #c8e6c9">
            <div class="small fw-semibold text-success mb-1"><i class="bi bi-info-circle"></i> Demo Credentials</div>
            <div class="small text-muted">
                <div class="d-flex justify-content-between"><span>Admin:</span> <code>Admin / admin123</code></div>
                <div class="d-flex justify-content-between"><span>Cashier:</span> <code>cashier1 / cashier123</code></div>
            </div>
        </div>

        <div class="text-center mt-4 small text-muted">
            Protected by IbukunOluwa Secure Login
        </div>
    </div>
</div>

</body>
</html>