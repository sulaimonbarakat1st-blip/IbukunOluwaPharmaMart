@model IbukunOluwaPharmaMart.Models.Product
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit? "Edit Product" : "Add New Drug";
}
<div class="row justify-content-center">
<div class="col-lg-9">
<div class="card border-0 shadow-lg rounded-4 p-4">
    <h4 class="fw-bold text-success">@ViewData["Title"]</h4>
    <form asp-action="@(isEdit? "Edit" : "Create")" method="post" class="row g-3 mt-2">
        @if(isEdit){<input type="hidden" asp-for="Id" />}
        <div class="col-md-6"><label class="fw-bold">Drug Name</label><input asp-for="Name" class="form-control rounded-3" required /></div>
        <div class="col-md-6"><label class="fw-bold">Category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select rounded-3"></select></div>
        <div class="col-md-6"><label class="fw-bold">Cost Price (₦)</label><input asp-for="CostPrice" type="number" step="0.01" class="form-control rounded-3" required /></div>
        <div class="col-md-6"><label class="fw-bold">Selling Price (₦)</label><input asp-for="SellingPrice" type="number" step="0.01" class="form-control rounded-3" required /></div>
        <div class="col-md-4"><label class="fw-bold">Quantity</label><input asp-for="Quantity" type="number" class="form-control rounded-3" required /></div>
        <div class="col-md-4"><label class="fw-bold">Low Stock Alert</label><input asp-for="LowStockLevel" type="number" class="form-control rounded-3" /></div>
        <div class="col-md-4"><label class="fw-bold">Dosage</label><input asp-for="Dosage" placeholder="e.g. 500mg" class="form-control rounded-3" /></div>
        <div class="col-md-4"><label class="fw-bold">NAFDAC No</label><input asp-for="NAFDACNo" class="form-control rounded-3" /></div>
        <div class="col-md-4"><label class="fw-bold">Batch No</label><input asp-for="BatchNo" class="form-control rounded-3" /></div>
        <div class="col-md-4"><label class="fw-bold">Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control rounded-3" /></div>
        <div class="col-12 d-flex gap-2 mt-2">
            <button class="btn btn-success rounded-pill px-5 fw-bold">💾 Save Product</button>
            <a href="/Products" class="btn btn-light rounded-pill">Cancel</a>
        </div>
    </form>
</div>
</div>
</div>