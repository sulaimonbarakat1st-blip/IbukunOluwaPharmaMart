@model IbukunOluwaPharmaMart.Models.Product
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Product" : "Add New Drug";
}
<style>
    body{ background:#f0f7f2 !important; }
    .edit-wrap{ max-width:880px; margin:18px auto; background:#fff !important; border-radius:20px; overflow:hidden; box-shadow:0 15px 40px rgba(15,109,47,0.12); border:1px solid #e6f0ea; }
    .edit-header{ background:linear-gradient(135deg,#0f6d2f,#14b8a6) !important; padding:20px 26px; color:white; display:flex; justify-content:space-between; align-items:center; }
    .edit-header h4{ margin:0; font-weight:900; font-size:22px; color:white !important; }
    .edit-header span{ background:rgba(255,255,255,0.22); padding:6px 12px; border-radius:20px; font-size:12px; font-weight:700; color:white; }
    .edit-body{ padding:24px 26px 28px; }
    .edit-body label{ font-weight:800 !important; font-size:13px !important; color:#111827 !important; margin-bottom:6px !important; text-transform:uppercase; }
    .edit-body .form-control, .edit-body select{ border:1.5px solid #d1d5db !important; border-radius:12px !important; padding:11px 14px !important; font-size:15px !important; font-weight:600 !important; color:#111827 !important; background:#fff !important; }
    .edit-body .form-control:focus{ border-color:#0f6d2f !important; box-shadow:0 0 0 4px rgba(15,109,47,0.12) !important; outline:none !important; }
    .edit-body .btn-success{ background:linear-gradient(135deg,#0f6d2f,#14b8a6) !important; border:none !important; border-radius:12px !important; padding:12px 30px !important; font-weight:900 !important; font-size:15px !important; }
</style>

<div class="edit-wrap">
    <div class="edit-header">
        <h4>💊 @ViewData["Title"]</h4>
        <span>IbukunOluwa PharmaMart</span>
    </div>
    <div class="edit-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="row g-3">
            @if(isEdit){<input type="hidden" asp-for="Id" />}
            <div class="col-md-6"><label>Drug Name</label><input asp-for="Name" class="form-control" required /></div>
            <div class="col-md-6"><label>Category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div>
            <div class="col-md-6"><label>Drug Picture</label><input type="file" name="imageFile" class="form-control" /></div>
            <div class="col-md-6"><label>Cost Price (₦)</label><input asp-for="CostPrice" type="number" step="0.01" class="form-control" required /></div>
            <div class="col-md-6"><label>Retail Price (₦) - Walk-in-Customer</label><input asp-for="RetailPrice" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-6"><label>Wholesale Price (₦) - Bulk Price</label><input asp-for="WholesalePrice" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-4"><label>Quantity</label><input asp-for="Quantity" type="number" class="form-control" required /></div>
            <div class="col-md-4"><label>Low Stock Alert</label><input asp-for="LowStockLevel" type="number" class="form-control" /></div>
            <div class="col-md-4"><label>Dosage</label><input asp-for="Dosage" placeholder="e.g. 500mg" class="form-control" /></div>
            <div class="col-md-4"><label>NAFDAC No</label><input asp-for="NAFDACNo" class="form-control" /></div>
            <div class="col-md-4"><label>Batch No</label><input asp-for="BatchNo" class="form-control" /></div>
            <div class="col-md-4"><label>Expiry Date</label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button class="btn btn-success">💾 Save Product</button>
                <a href="/Products" class="btn btn-light rounded-pill">Cancel</a>
            </div>
        </form>
    </div>
</div>