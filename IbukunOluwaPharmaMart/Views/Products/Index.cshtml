@model List<IbukunOluwaPharmaMart.Models.Product>
@{
    ViewData["Title"] = "Products";
}
<style>
.pharma-header{background:linear-gradient(135deg,#0f8a4a,#06532b); color:white; border-radius:20px; padding:24px}
.card-product{border:0; border-radius:18px; box-shadow:0 8px 30px rgba(0,0,0,.06)}
.badge-low{background:#fee2e2;color:#991b1b}.badge-ok{background:#dcfce7;color:#166534}
</style>

<div class="pharma-header d-flex justify-content-between align-items-center mb-4">
    <div><h3 class="fw-bold mb-0">💊 Pharmacy Stock - IbukunOluwa</h3><small class="opacity-75">NAFDAC tracked inventory</small></div>
    <a href="/Products/Create" class="btn btn-light rounded-pill fw-bold px-4">+ New Drug</a>
</div>

<form method="get" class="card border-0 shadow-sm rounded-4 p-2 mb-4 d-flex flex-row gap-2">
    <input name="search" value="@ViewBag.Search" class="form-control rounded-pill" placeholder="Search name or NAFDAC No..." />
    <button class="btn btn-success rounded-pill px-4">Search</button>
</form>

<div class="row g-3">
@foreach(var p in Model){
<div class="col-md-4 col-xl-3">
  <div class="card card-product p-3 h-100">
    <div class="d-flex justify-content-between">
        @if(p.Quantity <= p.LowStockLevel){<span class="badge badge-low rounded-pill">Low Stock</span>}else{<span class="badge badge-ok rounded-pill">In Stock</span>}
        <small class="text-muted fw-bold">@p.Category?.Name</small>
    </div>
    <h5 class="fw-bold mt-3 mb-1">@p.Name</h5>
    <small class="text-muted">@p.Dosage • Batch: @p.BatchNo</small>
    <div class="mt-2 small"><b>NAFDAC:</b> @p.NAFDACNo</div>
    <div class="small text-danger"><b>Expiry:</b> @(p.ExpiryDate?.ToString("MMM yyyy")?? "N/A")</div>
    <hr/>
    <div class="d-flex justify-content-between">
        <div><small class="text-muted">Cost</small><div class="fw-bold">₦@p.CostPrice.ToString("N2")</div></div>
        <div class="text-end"><small class="text-muted">Selling</small><div class="fw-bold text-success fs-5">₦@p.SellingPrice.ToString("N2")</div></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="badge bg-light border text-dark rounded-pill">Qty: @p.Quantity</span>
        <div>
            <a href="/Products/Edit/@p.Id" class="btn btn-sm btn-outline-success rounded-pill">Edit</a>
            <a href="/Products/Delete/@p.Id" onclick="return confirm('Delete?')" class="btn btn-sm btn-outline-danger rounded-pill">Del</a>
        </div>
    </div>
  </div>
</div>
}
</div>